# Copie este arquivo para .env e preencha.

# ---------------------------------------------------------------- Firebase
# Caminho do JSON da conta de serviço.
# Console do Firebase → Configurações do projeto → Contas de serviço
#                     → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT=data/firebase-key.json

# Opcional: só é necessário se o JSON não tiver project_id.
# FIREBASE_PROJECT_ID=rede-apoio-claudia

# Espelhar o histórico bruto de mensagens no Firestore.
# Deixe false: o volume é alto e o painel não precisa disso para funcionar.
FIRESTORE_ESPELHAR_MENSAGENS=false

# De quanto em quanto tempo a fila sobe (ms).
FIRESTORE_INTERVALO_MS=15000

# ---------------------------------------------------------------- WhatsApp
# Importar as conversas que já existem no aparelho ao conectar.
# true  = espelho completo (recomendado num número novo, só da campanha)
# false = só o que chegar daqui pra frente
SINCRONIZAR_HISTORICO=true

# Nome usado nas sugestões de resposta.
CANDIDATA=

# Link público do cadastro, usado nas sugestões de resposta.
URL_CADASTRO=http://localhost:3333/cadastro

# Número que recebe os avisos (saída de grupo, remoção etc.), com DDI.
# Deixe em branco para não enviar nada por WhatsApp — os alertas continuam
# aparecendo no painel de qualquer forma.
ALERTA_WHATSAPP=

# ---------------------------------------------------------------- Servidor
PORT=3333

# ------------------------------------------------- Fila de adição a grupo
# Ritmo conservador de propósito: adicionar rápido derruba o número.
# Subir esses valores aumenta o risco de bloqueio.
ADICAO_INTERVALO_MIN=90        # segundos entre uma adição e outra (mínimo)
ADICAO_INTERVALO_MAX=210       # (máximo — o intervalo real é sorteado)
ADICAO_POR_DIA=50
ADICAO_POR_HORA=15
ADICAO_HORA_INICIO=9           # não adiciona de madrugada
ADICAO_HORA_FIM=20
ADICAO_FALHAS_PAUSA=3          # erros seguidos que param a fila sozinha
ADICAO_PAUSA_LONGA_A_CADA=12   # pessoas
ADICAO_PAUSA_LONGA_MIN=12      # minutos de pausa longa
