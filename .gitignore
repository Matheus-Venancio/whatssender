node_modules/
.env

# Bancos de dados — um por campanha, mais o de contas.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/campanhas/*/*.db
data/campanhas/*/*.db-wal
data/campanhas/*/*.db-shm

# Sessões do WhatsApp: dão acesso à conta. Nunca versionar.
data/auth/
data/campanhas/*/auth/

# Chaves do Firebase: acesso total ao banco de cada campanha.
data/firebase-key.json
data/campanhas/*/firebase-key.json

# CSVs de leads contêm dado pessoal.
data/leads/*.csv
data/campanhas/*/leads/*.csv

# Backups deixados por refatorações.
*.bak

# Arquivo de desenvolvimento — não vai para produção.
.env.dev

# Trava de instância única: estado de execução, não código.
data/.instancia.lock

# Pastas de teste isoladas.
data-teste-*/
# Backups de base e artefatos do mount — nunca versionar (contêm dado pessoal).
*.db.backup-*
.fuse_hidden*
data-restaura/
